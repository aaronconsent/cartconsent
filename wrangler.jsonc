{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cartconsent-website",
  "compatibility_date": "2024-12-01",
  // Root-level config for Cloudflare Workers Builds (git-connected, runs from the
  // repo root). The site is built into site/dist by `npm run build` (root
  // package.json), and served as static assets from there.
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  }
}
