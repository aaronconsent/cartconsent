---
import { FOOTER_NAV, SITE } from "~/lib/site";
const year = new Date().getFullYear();
const cols: [string, readonly { label: string; href: string }[]][] = [
  ["Product", FOOTER_NAV.product],
  ["Developers", FOOTER_NAV.developers],
  ["Company", FOOTER_NAV.company],
];
---

<footer class="section-dark border-t border-[color:var(--color-rule)]">
  <div class="container-content py-16">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2 font-display text-lg font-extrabold text-[color:var(--color-on-inverse)]">
          <span class="grid size-8 place-items-center rounded-lg text-[color:var(--color-on-brand)]" style="background: var(--color-brand)" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h2.2l2.1 11.2a1.8 1.8 0 0 0 1.8 1.4h8.4a1.8 1.8 0 0 0 1.8-1.4L21 7H6"/></svg>
          </span>
          CartConsent
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-[color:var(--color-on-inverse-muted)]">
          Cart recovery, cookie consent, and legal pages for WooCommerce — free.
          Pay only for visitor resolution, and only when you want it.
        </p>
        <p class="mt-4 text-sm text-[color:var(--color-on-inverse-muted)]">
          <a href={`mailto:${SITE.email}`} class="hover:text-[color:var(--color-brand)]">{SITE.email}</a>
        </p>
      </div>

      {
        cols.map(([title, items]) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-[color:var(--color-on-inverse-muted)]">{title}</h3>
            <ul class="mt-4 space-y-2.5">
              {items.map((i) => (
                <li>
                  <a href={i.href} class="text-sm text-[color:var(--color-on-inverse)]/85 transition-colors hover:text-[color:var(--color-brand)]">
                    {i.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-[color:var(--color-rule)] pt-6 text-xs text-[color:var(--color-on-inverse-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} CartConsent — a {""}<a href="https://consentresolve.com" class="underline hover:text-[color:var(--color-brand)]">Consent Resolve</a> product.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {FOOTER_NAV.legal.map((i) => (
          <li><a href={i.href} class="hover:text-[color:var(--color-brand)]">{i.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
