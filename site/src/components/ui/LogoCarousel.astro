---
interface Logo {
  name: string;
  /** Optional path to an SVG/PNG logo file under /public. When set, the
   *  image is rendered at a uniform row height instead of a styled
   *  wordmark text fallback. */
  logo?: string;
  family?: "display" | "mono" | "sans";
  weight?: "normal" | "bold" | "black";
}
interface Props {
  logos: Logo[];
  variant?: "marquee" | "grid" | "static";
  speed?: number; // seconds per cycle for marquee
  label?: string;
  /** Tailwind class controlling the rendered row height of image logos
   *  (and the visual size of text fallbacks). Default h-7. */
  rowHeight?: string;
}
const {
  logos,
  variant = "marquee",
  speed = 40,
  label,
  rowHeight = "h-7",
} = Astro.props as Props;

const loop = [...logos, ...logos];

const fontClass = (l: Logo) => {
  const fam = l.family === "mono" ? "font-mono" : l.family === "sans" ? "font-sans" : "font-display";
  const w = l.weight === "normal" ? "font-medium" : l.weight === "black" ? "font-black" : "font-bold";
  return `${fam} ${w}`;
};

// Shared per-item class strings. The actual <img>/<span> branch happens
// inline in each variant's template below — Astro frontmatter can't
// return JSX, so we keep the markup in the template section.
const imgClass = `shrink-0 w-auto opacity-70 transition-opacity hover:opacity-100 ${rowHeight}`;
---

{variant === "marquee" && (
  <div class="logo-carousel relative overflow-hidden">
    {label && (
      <p class="mb-4 text-center text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">{label}</p>
    )}
    <div class="lc-track flex items-center gap-12 whitespace-nowrap py-2" style={`animation-duration:${speed}s`}>
      {loop.map((l) => (
        l.logo ? (
          <img src={l.logo} alt={l.name} class={imgClass} loading="lazy" decoding="async" />
        ) : (
          <span class:list={["shrink-0 text-xl tracking-tight text-[color:var(--color-ink-2)] opacity-80", fontClass(l)]}>{l.name}</span>
        )
      ))}
    </div>
    <div class="pointer-events-none absolute inset-y-0 left-0 w-20 bg-gradient-to-r from-[color:var(--color-bg)] to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 w-20 bg-gradient-to-l from-[color:var(--color-bg)] to-transparent"></div>
  </div>
)}

{variant === "grid" && (
  <div>
    {label && (
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">{label}</p>
    )}
    <div class="grid grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {logos.map((l) => (
        <div class="flex items-center justify-center py-2">
          {l.logo ? (
            <img src={l.logo} alt={l.name} class={imgClass} loading="lazy" decoding="async" />
          ) : (
            <span class:list={["text-xl tracking-tight text-[color:var(--color-ink-2)] opacity-80", fontClass(l)]}>{l.name}</span>
          )}
        </div>
      ))}
    </div>
  </div>
)}

{variant === "static" && (
  <div>
    {label && (
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">{label}</p>
    )}
    <div class="flex flex-wrap items-center gap-x-10 gap-y-4">
      {logos.map((l) => (
        l.logo ? (
          <img src={l.logo} alt={l.name} class={imgClass} loading="lazy" decoding="async" />
        ) : (
          <span class:list={["text-lg tracking-tight text-[color:var(--color-ink-2)] opacity-80", fontClass(l)]}>{l.name}</span>
        )
      ))}
    </div>
  </div>
)}

<style>
  .lc-track {
    animation-name: lc-scroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    width: max-content;
  }
  .logo-carousel:hover .lc-track { animation-play-state: paused; }
  @keyframes lc-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lc-track { animation: none; }
  }
</style>
