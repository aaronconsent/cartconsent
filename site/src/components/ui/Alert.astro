---
import { IconInfoCircle, IconCircleCheck, IconAlertTriangle, IconAlertOctagon } from "@tabler/icons-react";

interface Props {
  variant?: "info" | "success" | "warning" | "danger";
  title?: string;
  dismissible?: boolean;
}
const { variant = "info", title, dismissible = false } = Astro.props as Props;

const map = {
  info:    { bg: "bg-sky-50",      ring: "ring-sky-200",     text: "text-sky-900",     Icon: IconInfoCircle,    iconColor: "#0284c7" },
  success: { bg: "bg-[color:var(--color-brand-soft)]", ring: "ring-[color:var(--color-brand)]/30", text: "text-[color:var(--color-brand-pressed)]", Icon: IconCircleCheck, iconColor: "#00A86E" },
  warning: { bg: "bg-amber-50",    ring: "ring-amber-200",   text: "text-amber-900",   Icon: IconAlertTriangle, iconColor: "#d97706" },
  danger:  { bg: "bg-red-50",      ring: "ring-red-200",     text: "text-red-900",     Icon: IconAlertOctagon,  iconColor: "#dc2626" },
} as const;

const v = map[variant];
---

<div class:list={["relative rounded-xl p-4 ring-1 ring-inset", v.bg, v.ring]} role="alert">
  <div class="flex gap-3">
    <v.Icon size={20} stroke={1.75} color={v.iconColor} className="shrink-0 mt-0.5" />
    <div class="flex-1 min-w-0">
      {title && <p class:list={["mb-1 font-semibold tracking-tight", v.text]}>{title}</p>}
      <div class:list={["text-sm leading-relaxed", v.text]}>
        <slot />
      </div>
    </div>
    {dismissible && (
      <button class="shrink-0 -mr-1 -mt-1 rounded-md p-1 opacity-50 hover:opacity-100" aria-label="Dismiss">
        <svg width="14" height="14" viewBox="0 0 14 14"><path d="M3 3L11 11M11 3L3 11" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
      </button>
    )}
  </div>
</div>
