---
import { IconTrendingUp, IconTrendingDown } from "@tabler/icons-react";
import Sparkline from "./Sparkline.astro";

interface Props {
  label: string;
  value: string;
  delta?: { direction: "up" | "down"; value: string; period?: string };
  sparkline?: number[];
  variant?: "default" | "dark";
  icon?: any;
}
const { label, value, delta, sparkline, variant = "default", icon: Icon } = Astro.props as Props;
const isDark = variant === "dark";
---

<div class:list={[
  "rounded-2xl p-5",
  isDark
    ? "bg-[color:var(--color-navy-900)] text-white"
    : "bg-[color:var(--color-bg-alt)] ring-1 ring-inset ring-[color:var(--color-rule)]"
]}>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class:list={["flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em]", isDark ? "text-slate-400" : "text-[color:var(--color-ink-muted)]"]}>
        {Icon && <Icon size={14} stroke={1.75} />}
        {label}
      </div>
      <div class:list={["mt-2 font-display text-3xl font-bold tracking-tight leading-none", isDark ? "text-[color:var(--color-mint-400)]" : "text-[color:var(--color-ink)]"]}>
        {value}
      </div>
    </div>
    {sparkline && <Sparkline data={sparkline} width={80} height={32} tone={isDark ? "brand" : "brand"} />}
  </div>
  {delta && (
    <div class="mt-3 flex items-center gap-1.5 text-xs">
      <span class:list={[
        "inline-flex items-center gap-0.5 rounded-full px-2 py-0.5 font-semibold",
        delta.direction === "up"
          ? "bg-[color:var(--color-brand-soft)] text-[color:var(--color-brand-pressed)]"
          : "bg-red-50 text-red-700"
      ]}>
        {delta.direction === "up" ? <IconTrendingUp size={12} stroke={2.5} /> : <IconTrendingDown size={12} stroke={2.5} />}
        {delta.value}
      </span>
      {delta.period && <span class:list={[isDark ? "text-slate-400" : "text-[color:var(--color-ink-muted)]"]}>{delta.period}</span>}
    </div>
  )}
</div>
