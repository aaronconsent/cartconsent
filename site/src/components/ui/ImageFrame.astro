---
interface Props {
  src: string;
  alt?: string;
  variant?: "plain" | "bordered" | "shadow" | "polaroid" | "browser" | "phone";
  caption?: string;
  ratio?: "16/9" | "4/3" | "1/1";
}
const { src, alt = "", variant = "plain", caption, ratio = "16/9" } = Astro.props as Props;
const ratioClass = ratio === "4/3" ? "aspect-[4/3]" : ratio === "1/1" ? "aspect-square" : "aspect-video";
---

{variant === "plain" && (
  <figure>
    <div class:list={["relative overflow-hidden rounded-2xl bg-[color:var(--color-bg)]", ratioClass]}>
      <img src={src} alt={alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    </div>
    {caption && <figcaption class="mt-3 text-sm text-[color:var(--color-ink-muted)]">{caption}</figcaption>}
  </figure>
)}

{variant === "bordered" && (
  <figure>
    <div class:list={["relative overflow-hidden rounded-2xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)]", ratioClass]}>
      <img src={src} alt={alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    </div>
    {caption && <figcaption class="mt-3 text-sm text-[color:var(--color-ink-muted)]">{caption}</figcaption>}
  </figure>
)}

{variant === "shadow" && (
  <figure>
    <div class:list={["relative overflow-hidden rounded-2xl bg-[color:var(--color-bg)] shadow-[0_30px_60px_-20px_rgba(10,22,40,0.25),0_0_0_1px_rgba(10,22,40,0.06)]", ratioClass]}>
      <img src={src} alt={alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    </div>
    {caption && <figcaption class="mt-3 text-sm text-[color:var(--color-ink-muted)]">{caption}</figcaption>}
  </figure>
)}

{variant === "polaroid" && (
  <figure class="rotate-[-1deg] rounded-md bg-white p-3 shadow-[0_18px_36px_-12px_rgba(10,22,40,0.25)]">
    <div class:list={["relative overflow-hidden", ratioClass]}>
      <img src={src} alt={alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    </div>
    {caption && <figcaption class="mt-3 text-center font-display text-sm text-[color:var(--color-ink-2)]">{caption}</figcaption>}
  </figure>
)}

{variant === "browser" && (
  <figure class="overflow-hidden rounded-xl ring-1 ring-inset ring-[color:var(--color-rule)]">
    <div class="flex items-center gap-1.5 border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg)] px-3 py-2">
      <span class="size-2.5 rounded-full bg-red-400"></span>
      <span class="size-2.5 rounded-full bg-amber-400"></span>
      <span class="size-2.5 rounded-full bg-green-400"></span>
      <span class="ml-3 inline-block rounded-md bg-white px-3 py-0.5 text-[11px] text-[color:var(--color-ink-muted)] ring-1 ring-inset ring-[color:var(--color-rule)]">
        consentresolve.com
      </span>
    </div>
    <div class:list={["relative", ratioClass]}>
      <img src={src} alt={alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
    </div>
  </figure>
)}

{variant === "phone" && (
  <figure class="mx-auto w-[260px]">
    <div class="rounded-[2rem] bg-[color:var(--color-navy-900)] p-2 shadow-[0_30px_60px_-20px_rgba(10,22,40,0.4)]">
      <div class="overflow-hidden rounded-[1.65rem] bg-[color:var(--color-bg)]">
        <div class:list={["relative", ratioClass]}>
          <img src={src} alt={alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
    {caption && <figcaption class="mt-3 text-center text-sm text-[color:var(--color-ink-muted)]">{caption}</figcaption>}
  </figure>
)}
