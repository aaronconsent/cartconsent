---
import { IconCheck, IconX, IconArrowRight, IconCrown, IconExternalLink } from "@tabler/icons-react";
import RatingStars from "./RatingStars.astro";

interface ScoreItem { label: string; value: number; }

interface Props {
  brand: string;
  initials?: string;
  logoColor?: string;
  tagline?: string;
  rating?: number;          // 0-5
  score?: number;           // 0-100
  scoreBreakdown?: ScoreItem[];
  price?: string;
  priceSub?: string;
  bestFor?: string;
  pros?: string[];
  cons?: string[];
  ctaLabel: string;
  ctaHref: string;
  reviewHref?: string;
  featured?: boolean;
  ribbonLabel?: string;
}
const {
  brand,
  initials,
  logoColor = "#0A1628",
  tagline,
  rating,
  score,
  scoreBreakdown,
  price,
  priceSub,
  bestFor,
  pros = [],
  cons = [],
  ctaLabel,
  ctaHref,
  reviewHref,
  featured = false,
  ribbonLabel = "Editor's Pick",
} = Astro.props as Props;

const monogram = initials ?? brand.split(/\s+/).map((s) => s[0]).slice(0, 2).join("").toUpperCase();

// score colors
const sv = score ?? 0;
const scoreColor =
  sv >= 80 ? "#00E5A0" :
  sv >= 60 ? "#3B82F6" :
  sv >= 40 ? "#F59E0B" : "#EC4899";
const scoreGrade =
  sv >= 90 ? "A+" :
  sv >= 80 ? "A"  :
  sv >= 70 ? "B"  :
  sv >= 60 ? "C"  :
  sv >= 40 ? "D"  : "F";
---

<article
  class:list={[
    "relative flex flex-col rounded-3xl transition-all",
    featured
      ? "bg-[color:var(--color-bg-alt)] ring-[3px] ring-[color:var(--color-brand)] shadow-[0_40px_80px_-30px_rgba(0,192,128,0.45)] scale-[1.02] lg:scale-[1.04]"
      : "bg-[color:var(--color-bg-alt)] ring-1 ring-inset ring-[color:var(--color-rule)] shadow-[0_1px_0_rgba(10,22,40,0.04),0_18px_40px_-24px_rgba(10,22,40,0.12)]"
  ]}
>
  {/* Featured top accent bar */}
  {featured && (
    <div class="absolute inset-x-0 top-0 h-1.5 rounded-t-3xl bg-gradient-to-r from-[color:var(--color-mint-400)] via-[color:var(--color-brand)] to-[color:var(--color-mint-400)]"></div>
  )}

  {/* Editor's pick ribbon */}
  {featured && (
    <div class="absolute -top-4 left-1/2 inline-flex -translate-x-1/2 items-center gap-2 rounded-full bg-[color:var(--color-navy-900)] px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-[color:var(--color-mint-400)] shadow-[0_8px_24px_-8px_rgba(10,22,40,0.6)] ring-1 ring-inset ring-[color:var(--color-mint-400)]/40">
      <IconCrown size={14} stroke={2.25} color="#00E5A0" />
      {ribbonLabel}
    </div>
  )}

  <div class="p-8 lg:p-10 flex flex-col flex-1">
    <!-- Logo + brand identity -->
    <div class="flex flex-col items-center text-center mb-6">
      <div
        class="flex size-[88px] items-center justify-center rounded-2xl font-display text-2xl font-black tracking-tight text-white mb-5 shadow-[0_8px_24px_-8px_rgba(10,22,40,0.4)]"
        style={`background:${logoColor}`}
      >
        {monogram}
      </div>
      <h3 class="font-display text-base md:text-lg font-bold tracking-tight text-[color:var(--color-ink)] leading-[1.1]">{brand}</h3>
    </div>

    <!-- Rating row -->
    {rating != null && (
      <div class="mb-5 flex justify-center">
        <RatingStars value={rating} size={20} />
      </div>
    )}

    <!-- Big score block -->
    {score != null && (
      <div class:list={[
        "mb-7 rounded-2xl px-5 py-5 text-center",
        featured ? "bg-[color:var(--color-brand-soft)]" : "bg-[color:var(--color-bg)]"
      ]}>
        <div class="flex items-baseline justify-center gap-2">
          <span class="font-display text-6xl font-black tracking-tighter leading-none" style={`color:${scoreColor}`}>{score}</span>
          <span class="text-base font-semibold text-[color:var(--color-ink-muted)]">/ 100</span>
        </div>
        <div class="mt-2 flex items-center justify-center gap-2">
          <span class="text-[10px] font-bold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">Overall Score</span>
          <span class="rounded-full px-2 py-0.5 text-[10px] font-black uppercase tracking-[0.14em] text-white" style={`background:${scoreColor}`}>{scoreGrade}</span>
        </div>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-[color:var(--color-rule)]">
          <div class="h-full rounded-full transition-[width] duration-700" style={`width:${score}%; background:${scoreColor}`}></div>
        </div>
      </div>
    )}

    <!-- Score breakdown (optional) -->
    {scoreBreakdown && scoreBreakdown.length > 0 && (
      <div class="mb-7 space-y-3">
        {scoreBreakdown.map((s) => (
          <div>
            <div class="mb-1 flex justify-between text-xs">
              <span class="font-semibold text-[color:var(--color-ink-2)]">{s.label}</span>
              <span class="font-mono font-bold text-[color:var(--color-ink)]">{s.value}</span>
            </div>
            <div class="h-1.5 overflow-hidden rounded-full bg-[color:var(--color-rule)]">
              <div class="h-full rounded-full bg-[color:var(--color-brand)]" style={`width:${s.value}%`}></div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Price block -->
    {price && (
      <div class="mb-6 border-y border-[color:var(--color-rule)] py-5 text-center">
        <div class="font-display text-5xl md:text-6xl font-black tracking-tighter leading-none text-[color:var(--color-ink)]">
          {price}
        </div>
        {priceSub && <div class="mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-ink-muted)]">{priceSub}</div>}
      </div>
    )}

    <!-- Best for chip -->
    {bestFor && (
      <div class="mb-6 text-center">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-[color:var(--color-navy-900)] px-4 py-2 text-xs font-bold uppercase tracking-[0.14em] text-[color:var(--color-mint-400)]">
          ⭐ Best for {bestFor}
        </span>
      </div>
    )}

    <!-- Pros -->
    {pros.length > 0 && (
      <div class="mb-5">
        <p class="mb-3 text-[11px] font-black uppercase tracking-[0.18em] text-[color:var(--color-brand-pressed)]">What you get</p>
        <ul class="space-y-3">
          {pros.map((p) => (
            <li class="flex items-start gap-3 text-[15px] leading-snug text-[color:var(--color-ink)] min-h-[24px]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-brand-soft)]">
                <IconCheck size={14} stroke={3} color="#00A86E" />
              </span>
              <span class="font-medium">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Cons -->
    {cons.length > 0 && (
      <div class="mb-6">
        <p class="mb-3 text-[11px] font-black uppercase tracking-[0.18em] text-[#dc2626]">Watch out for</p>
        <ul class="space-y-3">
          {cons.map((c) => (
            <li class="flex items-start gap-3 text-[15px] leading-snug text-[color:var(--color-ink-2)] min-h-[24px]">
              <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-red-50">
                <IconX size={14} stroke={3} color="#dc2626" />
              </span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Push CTA to bottom (auto-fills remaining space so CTAs align across cards) -->
    <div class="mt-auto"></div>

    <!-- CTA block -->
    <div class="mt-6 space-y-3">
      <a
        href={ctaHref}
        class:list={[
          "inline-flex w-full items-center justify-center gap-2 rounded-xl px-6 py-4 text-base font-black uppercase tracking-[0.08em] transition-all",
          featured
            ? "bg-[color:var(--color-brand)] text-[color:var(--color-on-brand)] hover:bg-[color:var(--color-brand-pressed)] hover:-translate-y-0.5 hover:shadow-[0_20px_40px_-12px_rgba(0,192,128,0.55)]"
            : "bg-[color:var(--color-navy-900)] text-white hover:bg-[color:var(--color-navy-700)]"
        ]}
      >
        {ctaLabel}
        <IconArrowRight size={18} stroke={2.5} />
      </a>
      {reviewHref && (
        <a
          href={reviewHref}
          class="inline-flex w-full items-center justify-center gap-1 text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-ink-muted)] transition-colors hover:text-[color:var(--color-ink)]"
        >
          Full review
          <IconExternalLink size={12} stroke={2} />
        </a>
      )}
    </div>
  </div>
</article>
