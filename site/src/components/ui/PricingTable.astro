---
import { IconCheck, IconX } from "@tabler/icons-react";
import Button from "./Button.astro";
import Badge from "./Badge.astro";

export interface Tier {
  name: string;
  price: string;
  period?: string;
  blurb?: string;
  features: { label: string; included: boolean }[];
  cta: { label: string; href: string };
  featured?: boolean;
  badge?: string;
}

interface Props {
  tiers: Tier[];
}
const { tiers } = Astro.props as Props;
---

<div class={`grid gap-6 ${tiers.length >= 3 ? "md:grid-cols-3" : "md:grid-cols-2"}`}>
  {tiers.map((t) => (
    <div
      class:list={[
        "relative rounded-2xl p-7 flex flex-col",
        t.featured
          ? "bg-[color:var(--color-navy-900)] text-white shadow-[0_30px_60px_-20px_rgba(10,22,40,0.35)]"
          : "bg-[color:var(--color-bg-alt)] ring-1 ring-inset ring-[color:var(--color-rule)]",
      ]}
    >
      {t.badge && (
        <span class="absolute -top-3 right-6">
          <Badge
            tone={t.featured ? "brand" : "neutral"}
            variant="solid"
            size="sm"
            uppercase
          >{t.badge}</Badge>
        </span>
      )}
      <div class="mb-5">
        <p class:list={["text-xs font-semibold uppercase tracking-[0.16em]", t.featured ? "text-[color:var(--color-mint-400)]" : "text-[color:var(--color-brand-pressed)]"]}>{t.name}</p>
        <div class="mt-3 flex items-baseline gap-1">
          <span class="font-display text-4xl font-bold tracking-tight">{t.price}</span>
          {t.period && <span class:list={["text-sm", t.featured ? "text-slate-300" : "text-[color:var(--color-ink-muted)]"]}>/{t.period}</span>}
        </div>
        {t.blurb && <p class:list={["mt-3 text-sm", t.featured ? "text-slate-300" : "text-[color:var(--color-ink-2)]"]}>{t.blurb}</p>}
      </div>
      <ul class="mb-7 flex-1 space-y-2.5">
        {t.features.map((f) => (
          <li class="flex items-start gap-2.5 text-sm">
            {f.included ? (
              <IconCheck size={16} stroke={2.5} className={t.featured ? "text-[#00E5A0] mt-0.5 shrink-0" : "text-[#00A86E] mt-0.5 shrink-0"} />
            ) : (
              <IconX size={16} stroke={2} className={t.featured ? "text-slate-500 mt-0.5 shrink-0" : "text-[color:var(--color-ink-muted)] mt-0.5 shrink-0"} />
            )}
            <span class:list={[f.included ? "" : "opacity-60", t.featured ? "text-slate-200" : "text-[color:var(--color-ink-2)]"]}>{f.label}</span>
          </li>
        ))}
      </ul>
      {t.featured ? (
        <a href={t.cta.href} class="inline-flex items-center justify-center gap-2 rounded-lg bg-[color:var(--color-mint-400)] px-5 py-3 text-sm font-semibold text-[color:var(--color-navy-900)] transition-colors hover:bg-[color:var(--color-mint-300)]">
          {t.cta.label}
        </a>
      ) : (
        <Button href={t.cta.href} variant="outline" fullWidth>{t.cta.label}</Button>
      )}
    </div>
  ))}
</div>
