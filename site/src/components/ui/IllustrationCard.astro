---
/**
 * IllustrationCard — illustration-led card primitive.
 *
 * Structure (top to bottom):
 *   1. Illustration plate (5:3 aspect, mint-soft → bg-alt gradient
 *      backdrop with two ambient glow blobs).
 *   2. Card body — title (display, black) + body copy.
 *   3. Optional "Learn more →" chip when `href` is set; whole card
 *      becomes the link.
 *
 * Use anywhere you want a feature/benefit grid that leads with brand
 * imagery instead of a Tabler icon — the /features/ hub and the
 * /how-it-works/ "three things" section are the canonical consumers.
 *
 * Source illustrations live under public/illustrations/{style,features,hiw}/.
 */
import { IconArrowRight } from "@tabler/icons-react";

interface Props {
  /** Path under /public to the SVG (e.g. "/illustrations/style/07-lead-house-lock.svg") */
  illustration: string;
  /** Card title — keep short, 1-3 words. */
  title: string;
  /** Body copy — plain-English benefit, ~1-3 sentences. */
  body: string;
  /** Optional URL — when set, the whole card becomes a link with a
   *  "Learn more →" chip at the bottom that nudges on hover. */
  href?: string;
  /** Override the CTA label. Defaults to "Learn more". */
  ctaLabel?: string;
  /** Alt text for the illustration. Decorative by default. */
  alt?: string;
}

const { illustration, title, body, href, ctaLabel = "Learn more", alt = "" } = Astro.props as Props;
const Tag = (href ? "a" : "div") as any;
const linkProps = href ? { href } : {};
---

<Tag
  {...linkProps}
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-3xl bg-[color:var(--color-bg)] ring-1 ring-inset ring-[color:var(--color-rule)] transition-all",
    href && "hover:-translate-y-1 hover:ring-[color:var(--color-brand)]/40 hover:shadow-[0_30px_60px_-28px_rgba(10,22,40,0.25)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-brand)] focus-visible:ring-offset-2",
  ]}
>
  <!-- Illustration plate -->
  <div class="relative flex aspect-[5/3] items-center justify-center overflow-hidden bg-gradient-to-br from-[color:var(--color-brand-soft)] via-[#e9f9f1] to-[color:var(--color-bg-alt)]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-12 -top-12 size-40 rounded-full bg-[color:var(--color-mint-400)]/20 blur-2xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -left-10 -bottom-10 size-32 rounded-full bg-[color:var(--color-mint-400)]/15 blur-2xl"></div>
    <img
      src={illustration}
      alt={alt}
      loading="lazy"
      decoding="async"
      class:list={[
        "relative z-10 max-h-[70%] w-auto max-w-[70%] object-contain transition-transform duration-500",
        href && "group-hover:scale-105",
      ]}
    />
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-7">
    <h3 class="font-display text-xl font-black tracking-tight text-[color:var(--color-ink)]">{title}</h3>
    <p class="mt-3 flex-1 text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{body}</p>
    {href && (
      <span class="mt-6 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[color:var(--color-brand-pressed)] transition-all group-hover:gap-2.5">
        {ctaLabel}
        <IconArrowRight size={14} stroke={2.5} />
      </span>
    )}
  </div>
</Tag>
