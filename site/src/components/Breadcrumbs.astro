---
import { breadcrumbSchema, type BreadcrumbItem } from "~/lib/seo";

interface Props {
  items: BreadcrumbItem[];
}
const { items } = Astro.props as Props;
const schema = breadcrumbSchema(items);
---

{
  items.length > 1 && (
    <>
      <nav aria-label="Breadcrumb" class="container-content pt-6 text-sm">
        <ol class="flex flex-wrap items-center gap-2 text-[color:var(--color-ink-2)]">
          {items.map((item, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span class="opacity-40">/</span>}
              {i === items.length - 1 ? (
                <span class="text-[color:var(--color-ink)] font-medium">{item.name}</span>
              ) : (
                <a class="hover:text-[color:var(--color-brand)]" href={item.href}>
                  {item.name}
                </a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </>
  )
}
