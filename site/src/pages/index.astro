---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { PLANS, SITE } from "~/lib/site";
const fmt = (n: number) => n.toLocaleString("en-US");

const problems = [
  {
    title: "You're renting your own cart recovery",
    body: "Retainful, AutomateWoo, CartFlows — all bill you every month, and several meter you by orders or contacts. Recovering a cart you already earned shouldn't carry a subscription.",
  },
  {
    title: "Compliance is bolted on with five plugins",
    body: "A cart-recovery plugin here, a cookie banner there, a policy generator somewhere else — none of them talk to each other, and your recovery emails still land in spam.",
  },
  {
    title: "One wrong capture and you're exposed",
    body: "Most cart plugins grab the email as the shopper types — before any consent exists. That's the GDPR “silent capture” problem, and it's why audiences get rejected and inboxes go cold.",
  },
];

const steps = [
  {
    n: "1",
    title: "Install the free plugin",
    body: "Upload to WordPress and activate. HPOS-ready, Cart & Checkout Blocks compatible, no build step, no account required.",
  },
  {
    n: "2",
    title: "Turn on recovery + consent",
    body: "A 3-step setup wizard sets your region, banner, and recovery sequence. Every captured cart gets a lawful basis stamped on it automatically.",
  },
  {
    n: "3",
    title: "Recover — the right way",
    body: "Emails send over your own SMTP with a one-click cart-restore link. Because consent is real, they reach the inbox. Watch recovered revenue in the dashboard.",
  },
];

const features = [
  {
    tag: "Free",
    title: "Free privacy banner",
    body: "A complete consent platform: banner + preference center, real script blocking for 58 services, Consent Mode v2, GPC honoring, and tamper-evident records — unbranded, un-metered, no account.",
    href: "/features/cookie-consent/",
    icon: `<path d="M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6l7-3z"/>`,
  },
  {
    tag: "Free",
    title: "Abandoned cart recovery",
    body: "Multi-step sequences, segmentation, A/B subjects, single-use coupons, exit-intent popup with double opt-in, and a revenue-recovered dashboard.",
    href: "/features/cart-recovery/",
    icon: `<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2.5 3h2.2l2.1 11.2a1.8 1.8 0 0 0 1.8 1.4h8.4a1.8 1.8 0 0 0 1.8-1.4L21 7H6"/>`,
  },
  {
    tag: "Free",
    title: "Legal documents",
    body: "Privacy, cookie, and terms pages generated from your details and a live scan — or drop in your Termageddon embed. They keep themselves current.",
    href: "/features/legal-documents/",
    icon: `<path d="M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/><path d="M14 2v6h6"/>`,
  },
  {
    tag: "Paid add-on",
    title: "Visitor resolution",
    body: "Put a name and email to the shoppers who abandon anonymously — from your own traffic, on a consented basis. Buy resolutions by the plan, cancel anytime.",
    href: "/features/visitor-resolution/",
    icon: `<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>`,
  },
];

const faqs = [
  {
    q: "Is the plugin really free?",
    a: "Yes. Cart recovery, the cookie banner, and the legal pages are free forever — no order limits, no contact metering, no branding. The only paid thing is visitor resolution, which is optional and usage-priced.",
  },
  {
    q: "What's the difference between Free and Pro?",
    a: "Both are free. Free runs the complete built-in privacy banner and cart recovery with no account. Pro is a free Consent Resolve account that upgrades you to the hosted banner (rules managed as laws change, records and privacy requests in one dashboard) and unlocks the superpowers: consent-clean retargeting audiences that protect your ROAS, and visitor resolution.",
  },
  {
    q: "What exactly do I pay for, then?",
    a: "Only visitor resolution — identifying the anonymous shoppers who leave without buying, so recovery can reach them. It's a monthly plan priced per resolution (from $0.60), and you only need it if you want it.",
  },
  {
    q: "How is this different from Retainful or AutomateWoo?",
    a: "Two ways. Price: the recovery engine is free instead of a monthly subscription. And method: we capture on a lawful basis (a submitted checkout, never keystroke-sniffing), so your emails land in the inbox and your audiences don't get rejected.",
  },
  {
    q: "Will it work with my stack?",
    a: "It's built for modern WooCommerce: HPOS-compatible order handling, Cart & Checkout Blocks support, works with your caching and SMTP plugins, and ships with hooks and filters for developers.",
  },
];
---

<BaseLayout
  title="CartConsent — Free WooCommerce Cart Recovery, Consent & Legal Pages"
  description="Recover abandoned WooCommerce carts, run a compliant cookie banner, and publish auto-updating legal pages — all in one free plugin. Pay only for visitor resolution."
>
  <!-- HERO -->
  <section class="section-tight relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto h-96 max-w-4xl rounded-full opacity-25 blur-3xl"
      style="background: radial-gradient(closest-side, var(--color-brand), transparent)"
      aria-hidden="true"
    >
    </div>
    <div class="container-content grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <span class="eyebrow">Free WooCommerce plugin</span>
        <h1 class="mt-4 font-display text-[clamp(2.4rem,5vw,4rem)] font-extrabold leading-[1.03] tracking-tight text-[color:var(--color-ink)]">
          Recover more carts. <span class="text-[color:var(--color-brand)]">Pay nothing</span> to start.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          CartConsent gives WooCommerce a complete free privacy banner — real script blocking,
          Consent Mode v2, GPC — plus abandoned-cart recovery and auto-updating legal pages,
          in one plugin. Even Pro is free. The only thing you ever pay for is visitor
          resolution, and only when you want it.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/pricing/#free" class="btn-primary">Get the free plugin</a>
          <a href="/demo/" class="btn-ghost border border-[color:var(--color-rule)]">See the live demo →</a>
        </div>
        <p class="mt-4 text-sm text-[color:var(--color-ink-muted)]">
          Free forever · No account · Installs in about 2 minutes
        </p>
      </div>

      <div class="relative">
        <div class="card-elevated overflow-hidden">
          <div class="flex items-center gap-1.5 border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg)] px-4 py-3">
            <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
            <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
            <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
            <span class="ml-2 font-mono text-xs text-[color:var(--color-ink-muted)]">WooCommerce · Cart Recovery</span>
          </div>
          <div class="space-y-4 p-6">
            <div class="flex items-baseline justify-between">
              <span class="text-sm font-semibold text-[color:var(--color-ink-2)]">Recovered this month</span>
              <span class="font-display text-3xl font-extrabold text-[color:var(--color-ink)]">$4,820</span>
            </div>
            <div class="h-2 w-full overflow-hidden rounded-full bg-[color:var(--color-brand-soft)]">
              <div class="h-full rounded-full" style="width:68%;background:var(--color-brand)"></div>
            </div>
            <div class="grid grid-cols-3 gap-3 pt-2">
              {[["Carts captured","312"],["Recovery rate","23%"],["Sequences","3 live"]].map(([k,v]) => (
                <div class="rounded-xl bg-[color:var(--color-bg)] p-3">
                  <div class="font-display text-xl font-bold text-[color:var(--color-ink)]">{v}</div>
                  <div class="text-xs text-[color:var(--color-ink-muted)]">{k}</div>
                </div>
              ))}
            </div>
            <div class="flex items-center gap-2 rounded-xl border border-[color:var(--color-free-soft)] bg-[color:var(--color-free-soft)] px-3 py-2 text-sm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-free)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <span class="text-[color:var(--color-ink-2)]">Every cart stamped with a lawful basis</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="border-y border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)]">
    <div class="container-content flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-6 text-sm font-medium text-[color:var(--color-ink-muted)]">
      <span>HPOS-compatible</span><span aria-hidden="true">·</span>
      <span>Cart &amp; Checkout Blocks</span><span aria-hidden="true">·</span>
      <span>Google Consent Mode v2</span><span aria-hidden="true">·</span>
      <span>GPC honored</span><span aria-hidden="true">·</span>
      <span>WCAG 2.2 AA</span>
    </div>
  </section>

  <!-- PROBLEM (StoryBrand: empathy + stakes) -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">The problem</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">
          Cart recovery shouldn't cost you a subscription — or your compliance.
        </h2>
        <p class="mt-4 text-lg text-[color:var(--color-ink-2)]">
          You did the hard part: you got the shopper to the checkout. Winning them back
          shouldn't mean a monthly bill and a legal headache.
        </p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {problems.map((p) => (
          <div class="card p-6">
            <div class="grid size-10 place-items-center rounded-xl bg-[color:var(--color-danger-soft)] text-[color:var(--color-danger)]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            </div>
            <h3 class="mt-4 font-display text-lg font-bold text-[color:var(--color-ink)]">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GUIDE (authority) -->
  <section class="section-dark section-tight">
    <div class="container-content grid items-center gap-10 md:grid-cols-[0.8fr_1.2fr]">
      <img src="/illustrations/compliance-shield.svg" alt="" width="240" height="240" class="mx-auto w-48 md:w-60" />
      <div>
        <span class="eyebrow">Why trust CartConsent</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-on-inverse)]">
          Built by the team behind Consent Resolve.
        </h2>
        <p class="mt-4 text-lg text-[color:var(--color-on-inverse-muted)]">
          We build consent infrastructure for a living. CartConsent captures shoppers only on a
          deliberate action — a submitted checkout — never by sniffing keystrokes. Every cart is
          stamped with its lawful basis, emails are encrypted at rest, and non-consented captures
          auto-purge. That discipline is exactly why the emails reach the inbox and the audiences
          don't get rejected.
        </p>
        <a href="/features/cart-recovery/" class="btn-primary mt-6">How recovery works →</a>
      </div>
    </div>
  </section>

  <!-- FREE BANNER SPOTLIGHT -->
  <section class="section">
    <div class="container-content grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="card-elevated overflow-hidden">
        <div class="flex items-center gap-1.5 border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg)] px-4 py-3">
          <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
          <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
          <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
          <span class="ml-2 font-mono text-xs text-[color:var(--color-ink-muted)]">yourstore.com</span>
        </div>
        <div class="p-6">
          <div class="rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] p-5 shadow-sm">
            <div class="font-display text-base font-bold text-[color:var(--color-ink)]">We value your privacy</div>
            <p class="mt-1.5 text-sm leading-relaxed text-[color:var(--color-ink-2)]">We use cookies to improve your experience, analyze traffic, and for marketing. Accept all, reject non-essential, or choose what to allow.</p>
            <div class="mt-4 grid gap-2">
              <span class="rounded-lg border border-[color:var(--color-rule)] py-2 text-center text-sm font-semibold text-[color:var(--color-ink)]">Reject non-essential</span>
              <span class="rounded-lg py-2 text-center text-sm font-bold text-[color:var(--color-on-brand)]" style="background:var(--color-brand)">Accept all</span>
            </div>
            <div class="mt-3 flex gap-4 text-xs font-semibold text-[color:var(--color-brand)]"><span>Preferences</span><span class="text-[color:var(--color-ink-muted)]">Do Not Sell or Share My Personal Information</span></div>
          </div>
          <div class="mt-4 grid grid-cols-3 gap-2 text-center">
            {[["58","services blocked"],["5","banner layouts"],["0","pageview limits"]].map(([n, l]) => (
              <div class="rounded-xl bg-[color:var(--color-bg)] p-3">
                <div class="font-display text-xl font-bold text-[color:var(--color-ink)]">{n}</div>
                <div class="text-xs text-[color:var(--color-ink-muted)]">{l}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div>
        <span class="eyebrow">Free forever</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">A complete privacy banner. Actually free.</h2>
        <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Live the moment you activate: an accessible (WCAG 2.2 AA) banner and preference
          center, <strong class="text-[color:var(--color-ink)]">real script blocking for 58 services</strong>,
          Google Consent Mode v2 and Microsoft UET defaults, Global Privacy Control honored,
          and <strong class="text-[color:var(--color-ink)]">tamper-evident consent records</strong> in your own
          database. Region-aware for US opt-out, EU/UK opt-in, and Canada — auto-detected per visitor.
        </p>
        <p class="mt-3 text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          No account. No pageview metering. No vendor branding. The compliance features the law
          requires shouldn't be the paywall.
        </p>
        <a href="/features/cookie-consent/" class="btn-primary mt-6">Explore the free banner →</a>
      </div>
    </div>
  </section>

  <!-- PLAN (3 steps) -->
  <section id="how-it-works" class="section">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">The plan</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">Live in three steps.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {steps.map((s) => (
          <div class="card p-7">
            <span class="step-badge">{s.n}</span>
            <h3 class="mt-4 font-display text-lg font-bold text-[color:var(--color-ink)]">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURES (value stack) -->
  <section class="section-tight bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">Everything in one plugin</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">Three tools you'd pay for, free.</h2>
        <p class="mt-4 text-lg text-[color:var(--color-ink-2)]">Plus one optional paid add-on when you're ready to go further.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {features.map((f) => (
          <a href={f.href} class="card group flex gap-5 p-6 transition-shadow hover:shadow-lg">
            <span class="grid size-12 shrink-0 place-items-center rounded-xl text-[color:var(--color-on-brand)]" style="background: var(--color-brand)">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} />
            </span>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-display text-lg font-bold text-[color:var(--color-ink)]">{f.title}</h3>
                <span class={`rounded-full px-2 py-0.5 text-[11px] font-bold ${f.tag === "Free" ? "text-[color:var(--color-free)]" : "text-[color:var(--color-brand)]"}`} style={f.tag === "Free" ? "background:var(--color-free-soft)" : "background:var(--color-brand-soft)"}>{f.tag}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{f.body}</p>
              <span class="mt-3 inline-block text-sm font-semibold text-[color:var(--color-brand)] group-hover:underline">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- THE STORY: FREE -> PRO (FREE) -> RESOLUTION -->
  <section class="section-tight bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">How the free thing makes money</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">Free. Then Pro — also free. Pay only for results.</h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
        <div class="card p-7">
          <span class="rounded-full px-2.5 py-0.5 text-[11px] font-bold text-[color:var(--color-free)]" style="background:var(--color-free-soft)">Free</span>
          <h3 class="mt-3 font-display text-xl font-bold text-[color:var(--color-ink)]">The plugin</h3>
          <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">The complete privacy banner and the full cart-recovery engine — sequences, coupons, popup, analytics. No account, forever.</p>
        </div>
        <div class="card p-7 ring-2 ring-[color:var(--color-brand)]">
          <span class="rounded-full bg-[color:var(--color-brand-soft)] px-2.5 py-0.5 text-[11px] font-bold text-[color:var(--color-brand)]">Pro — also free</span>
          <h3 class="mt-3 font-display text-xl font-bold text-[color:var(--color-ink)]">Connect Consent Resolve</h3>
          <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">A free account gives your banner superpowers: the hosted banner with rules managed as laws change, consent records and privacy requests in one dashboard, and consent-clean retargeting audiences that protect your ROAS.</p>
        </div>
        <div class="card p-7">
          <span class="rounded-full bg-[color:var(--color-brand-soft)] px-2.5 py-0.5 text-[11px] font-bold text-[color:var(--color-brand)]">Pay per result</span>
          <h3 class="mt-3 font-display text-xl font-bold text-[color:var(--color-ink)]">Visitor resolution</h3>
          <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">The one paid add-on: name the shoppers who abandon anonymously so recovery can reach them — from $0.60 a resolution, month to month.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING TEASER -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">Simple pricing</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">The plugin is free. Resolution is pay-as-you-grow.</h2>
        <p class="mt-4 text-lg text-[color:var(--color-ink-2)]">
          Only visitor resolution costs anything — a monthly plan that gets cheaper per resolution as you scale.
        </p>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-3">
        {PLANS.map((p) => (
          <div class={`card relative flex flex-col p-7 ${"popular" in p && p.popular ? "ring-2 ring-[color:var(--color-brand)]" : ""}`}>
            {"popular" in p && p.popular && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-3 py-1 text-xs font-bold text-[color:var(--color-on-brand)]" style="background:var(--color-brand)">Most popular</span>
            )}
            <div class="font-display text-lg font-bold text-[color:var(--color-ink)]">{fmt(p.resolutions)} <span class="font-sans text-sm font-medium text-[color:var(--color-ink-muted)]">resolutions / mo</span></div>
            <div class="mt-3 flex items-baseline gap-1">
              <span class="font-display text-4xl font-extrabold text-[color:var(--color-ink)]">${fmt(p.monthly)}</span>
              <span class="text-sm text-[color:var(--color-ink-muted)]">/mo</span>
            </div>
            <div class="mt-1 text-sm text-[color:var(--color-brand)]">${p.perUnit.toFixed(2)} per resolution</div>
            <a href="/pricing/" class={`mt-6 ${"popular" in p && p.popular ? "btn-primary" : "btn-ghost border border-[color:var(--color-rule)]"}`}>Choose {fmt(p.resolutions)}</a>
          </div>
        ))}
      </div>
      <p class="mt-6 text-center text-sm text-[color:var(--color-ink-muted)]">All plans month-to-month. Cancel anytime. <a href="/pricing/" class="font-semibold text-[color:var(--color-brand)] hover:underline">Full pricing →</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-tight bg-[color:var(--color-bg-alt)]">
    <div class="container-content mx-auto max-w-3xl">
      <h2 class="text-center display-2 text-[color:var(--color-ink)]">Questions, answered</h2>
      <div class="mt-10 space-y-3">
        {faqs.map((f) => (
          <details class="card group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-[color:var(--color-ink)]">
              {f.q}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 transition-transform group-open:rotate-45"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section-dark section-tight">
    <div class="container-content text-center">
      <h2 class="mx-auto max-w-2xl display-2 text-[color:var(--color-on-inverse)]">
        Stop paying to recover carts you already earned.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-[color:var(--color-on-inverse-muted)]">
        Install CartConsent free, keep every dollar you recover, and add visitor resolution the day it pays for itself.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/pricing/#free" class="btn-primary">Get the free plugin</a>
        <a href="/demo/" class="btn-ghost border border-[color:var(--color-on-inverse-muted)]/30 text-[color:var(--color-on-inverse)]">Explore the demo</a>
      </div>
    </div>
  </section>
</BaseLayout>
