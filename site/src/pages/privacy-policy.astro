---
import LegalLayout from "~/layouts/LegalLayout.astro";
import { SITE } from "~/lib/site";
const updated = "July 29, 2026";
---

<LegalLayout
  title="Privacy Policy — CartConsent"
  description="How CartConsent collects, uses, and protects personal information on this website."
  heading="Privacy Policy"
  updated={updated}
>
  <p>
    This policy explains how <strong>{SITE.name}</strong> ("we", "us") handles personal information
    on this website, <a href={SITE.url}>{SITE.url.replace("https://", "")}</a>. It covers this
    marketing site — not the data your own store processes when you install our plugin, which you
    control.
  </p>

  <h2>Information we collect</h2>
  <ul>
    <li><strong>Information you provide</strong> — such as your name and email when you contact us, request support, or start a plan.</li>
    <li><strong>Technical information</strong> collected automatically — browser, device, pages viewed, and a coarse location derived from your network.</li>
    <li><strong>Cookies and similar technologies</strong>, as described in our <a href="/cookie-policy/">Cookie Policy</a>.</li>
  </ul>

  <h2>How we use it</h2>
  <ul>
    <li>To respond to your questions and provide support.</li>
    <li>To operate, secure, and improve this website.</li>
    <li>With your consent, to measure traffic and, where applicable, support marketing.</li>
  </ul>
  <p>We do not sell your personal information.</p>

  <h2>Cookies &amp; your choices</h2>
  <p>
    You can change or withdraw your cookie choices at any time using the consent controls on this
    site. We honor the Global Privacy Control (GPC) signal where the law treats it as a valid opt-out.
  </p>

  <h2>Your rights</h2>
  <p>
    Depending on where you live, you may have the right to access, correct, or delete your personal
    information, and to opt out of its sale or sharing. To exercise these rights, email us at
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>

  <h2>Data retention &amp; security</h2>
  <p>
    We keep personal information only as long as needed for the purposes above or as required by law,
    then delete it. We use reasonable technical and organizational measures to protect it.
  </p>

  <h2>Contact</h2>
  <p>
    Questions about this policy? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or write to
    {SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.postalCode}.
  </p>

  <div class="note">
    This policy is provided for transparency and is not legal advice. Your obligations depend on your
    business and jurisdiction; consult your own counsel.
  </div>
</LegalLayout>
