---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE } from "~/lib/site";

const tryThese = [
  { n: "1", title: "Browse and add to cart", body: "Shop the demo store and drop a product or two in your cart, just like a real shopper." },
  { n: "2", title: "Meet the consent banner", body: "See the WCAG-2.2-AA cookie banner and preference center — with real script blocking behind it." },
  { n: "3", title: "Abandon the checkout", body: "Start checkout, enter an email, then leave. That submitted checkout is captured on a lawful basis." },
  { n: "4", title: "Watch recovery fire", body: "The recovery sequence kicks off with a one-click cart-restore link — the same flow your shoppers get." },
];

const tour = [
  {
    tag: "Recovery",
    title: "Revenue-recovered dashboard",
    body: "Carts captured, recovery rate, and dollars won back — with per-sequence performance and A/B results.",
    href: "/features/cart-recovery/",
  },
  {
    tag: "Consent",
    title: "Banner & preference center",
    body: "A fast, accessible banner with Consent Mode v2, GPC honoring, and tamper-evident records.",
    href: "/features/cookie-consent/",
  },
  {
    tag: "Legal",
    title: "Auto-updating policy pages",
    body: "Privacy, Cookie, and Terms pages generated from a live scan — or your Termageddon embed.",
    href: "/features/legal-documents/",
  },
  {
    tag: "Resolution",
    title: "Named anonymous shoppers",
    body: "See how visitor resolution turns an anonymous abandoner into a lead you can follow up.",
    href: "/features/visitor-resolution/",
  },
];
---

<BaseLayout
  title="Live Demo — CartConsent on WooCommerce"
  description="Try CartConsent on a real WooCommerce store: shop, abandon a cart, see the consent banner, and watch the recovery flow — exactly what your shoppers experience."
>
  <!-- HERO -->
  <section class="section-tight">
    <div class="container-content mx-auto max-w-3xl text-center">
      <span class="eyebrow justify-center">Live demo</span>
      <h1 class="mt-4 font-display text-[clamp(2.2rem,4.5vw,3.4rem)] font-extrabold leading-[1.05] tracking-tight text-[color:var(--color-ink)]">
        See CartConsent on a real WooCommerce store.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Not a video — an actual WooCommerce store running the free plugin. Shop it, abandon a cart,
        and experience the exact banner and recovery flow your own shoppers would.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={SITE.demoUrl} class="btn-primary" target="_blank" rel="noopener">Open the demo store →</a>
        <a href="/pricing/#free" class="btn-ghost border border-[color:var(--color-rule)]">Get the free plugin</a>
      </div>
    </div>
  </section>

  <!-- STORE FRAME + TRY THESE -->
  <section class="section-tight">
    <div class="container-content grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="card-elevated overflow-hidden">
        <div class="flex items-center gap-1.5 border-b border-[color:var(--color-rule)] bg-[color:var(--color-bg)] px-4 py-3">
          <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
          <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
          <span class="size-2.5 rounded-full bg-[color:var(--color-rule)]"></span>
          <span class="ml-3 truncate font-mono text-xs text-[color:var(--color-ink-muted)]">{SITE.demoUrl.replace("https://", "")}</span>
        </div>
        <a href={SITE.demoUrl} target="_blank" rel="noopener" class="group block bg-[color:var(--color-bg)] p-8">
          <div class="grid gap-4 sm:grid-cols-2">
            {[["Nimbus Hoodie","$68.00"],["Field Tote","$42.00"],["Trail Mug","$18.00"],["Everyday Cap","$26.00"]].map(([name, price]) => (
              <div class="rounded-xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] p-4">
                <div class="aspect-[4/3] rounded-lg" style="background:linear-gradient(135deg,var(--color-brand-soft),transparent)"></div>
                <div class="mt-3 flex items-center justify-between">
                  <span class="text-sm font-semibold text-[color:var(--color-ink)]">{name}</span>
                  <span class="text-sm text-[color:var(--color-ink-2)]">{price}</span>
                </div>
                <div class="mt-2 rounded-md py-1.5 text-center text-xs font-bold text-[color:var(--color-on-brand)]" style="background:var(--color-brand)">Add to cart</div>
              </div>
            ))}
          </div>
          <div class="mt-6 text-center text-sm font-semibold text-[color:var(--color-brand)] group-hover:underline">Open the full store in a new tab →</div>
        </a>
      </div>

      <div>
        <h2 class="font-display text-xl font-bold text-[color:var(--color-ink)]">Try these four things</h2>
        <p class="mt-2 text-sm text-[color:var(--color-ink-2)]">Two minutes to feel the whole loop.</p>
        <div class="mt-6 space-y-4">
          {tryThese.map((t) => (
            <div class="flex gap-4">
              <span class="step-badge shrink-0">{t.n}</span>
              <div>
                <h3 class="font-display text-base font-bold text-[color:var(--color-ink)]">{t.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{t.body}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-6 flex items-start gap-2.5 rounded-xl border border-[color:var(--color-brand-soft)] bg-[color:var(--color-brand-soft)] p-4 text-sm text-[color:var(--color-ink-2)]">
          <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2.4" stroke-linecap="round"><path d="M12 16v-4M12 8h.01M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"/></svg>
          <span>Use any test email you like — the demo store sends recovery mail to the address you enter at checkout.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- GUIDED TOUR -->
  <section class="section-tight bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">What you'll see</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">Four surfaces, one plugin.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {tour.map((t) => (
          <a href={t.href} class="card group flex flex-col p-6 transition-shadow hover:shadow-lg">
            <span class="w-fit rounded-full bg-[color:var(--color-brand-soft)] px-2.5 py-0.5 text-[11px] font-bold text-[color:var(--color-brand)]">{t.tag}</span>
            <h3 class="mt-3 font-display text-base font-bold text-[color:var(--color-ink)]">{t.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{t.body}</p>
            <span class="mt-auto pt-4 text-sm font-semibold text-[color:var(--color-brand)] group-hover:underline">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark section-tight">
    <div class="container-content text-center">
      <h2 class="mx-auto max-w-2xl display-2 text-[color:var(--color-on-inverse)]">Liked the demo? It's the same plugin — and it's free.</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-[color:var(--color-on-inverse-muted)]">
        Install CartConsent on your own store and be recovering carts in a couple of minutes.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={SITE.github} class="btn-primary">Get the free plugin</a>
        <a href="/resources/docs/quick-start/" class="btn-ghost border border-[color:var(--color-on-inverse-muted)]/30 text-[color:var(--color-on-inverse)]">Read the quick start</a>
      </div>
    </div>
  </section>
</BaseLayout>
