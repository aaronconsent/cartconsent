---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE } from "~/lib/site";

const releases = [
  {
    version: "1.0",
    date: "Launch",
    tag: "Current",
    notes: [
      "Abandoned-cart recovery: multi-step sequences, segmentation, A/B subject testing, single-use coupons, and a revenue-recovered dashboard.",
      "Exit-intent cart-saver popup with double opt-in.",
      "Cookie-consent banner with real script blocking, Google Consent Mode v2, GPC honoring, and tamper-evident consent records.",
      "Auto-updating Privacy, Cookie, and Terms pages — generated from a live scan, or served from your Termageddon embed.",
      "Optional visitor resolution: identify anonymous abandoning shoppers on a consented basis.",
      "HPOS-compatible, Cart/Checkout Blocks support, works with your caching and SMTP plugins.",
    ],
  },
];
---

<BaseLayout
  title="Changelog — CartConsent"
  description="What's new in CartConsent — every release in plain language."
>
  <section class="section-tight">
    <div class="container-content mx-auto max-w-3xl">
      <div class="text-center">
        <span class="eyebrow justify-center">Changelog</span>
        <h1 class="mt-4 font-display text-[clamp(2.2rem,4.5vw,3.4rem)] font-extrabold leading-[1.05] tracking-tight text-[color:var(--color-ink)]">
          What's new
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
          Every release, in plain language. Full per-commit history lives on
          <a href={SITE.github} target="_blank" rel="noopener" class="font-semibold text-[color:var(--color-brand)] hover:underline">GitHub</a>.
        </p>
      </div>

      <div class="mt-14 space-y-10">
        {releases.map((r) => (
          <div class="relative border-l-2 border-[color:var(--color-rule)] pl-6">
            <span class="absolute -left-[9px] top-1.5 size-4 rounded-full border-2 border-[color:var(--color-bg)]" style="background:var(--color-brand)"></span>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="font-display text-2xl font-extrabold text-[color:var(--color-ink)]">v{r.version}</h2>
              {r.tag && <span class="rounded-full bg-[color:var(--color-brand-soft)] px-2.5 py-0.5 text-[11px] font-bold text-[color:var(--color-brand)]">{r.tag}</span>}
              <span class="text-sm text-[color:var(--color-ink-muted)]">{r.date}</span>
            </div>
            <ul class="mt-4 space-y-2.5">
              {r.notes.map((n) => (
                <li class="flex items-start gap-2.5 text-sm leading-relaxed text-[color:var(--color-ink-2)]">
                  <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{n}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="mt-12 text-center text-sm text-[color:var(--color-ink-muted)]">
        Want release notes in your inbox? <a href="/resources/support/" class="font-semibold text-[color:var(--color-brand)] hover:underline">Ask us to add you</a>.
      </p>
    </div>
  </section>
</BaseLayout>
