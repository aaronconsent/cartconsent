---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE } from "~/lib/site";

const groups = [
  {
    label: "The basics",
    faqs: [
      { q: "What is CartConsent?", a: "A free WooCommerce plugin that combines abandoned-cart recovery, a compliant cookie-consent banner, and auto-updating legal pages. The only paid, optional feature is visitor resolution — identifying anonymous abandoning shoppers." },
      { q: "Is it really free?", a: "Yes. Cart recovery, the cookie banner, and legal pages are free forever — no order limits, no contact metering, no branding. You only pay if you choose to add visitor resolution." },
      { q: "Who's behind it?", a: "CartConsent is built by the team behind Consent Resolve, a consent-infrastructure company. WooCommerce is our first integration; more platforms will follow." },
    ],
  },
  {
    label: "Cart recovery",
    faqs: [
      { q: "How is it different from Retainful or AutomateWoo?", a: "Two ways. Price: the recovery engine is free instead of a monthly subscription. Method: we capture on a lawful basis — a submitted checkout, never keystroke-sniffing — so emails land in the inbox and audiences aren't rejected." },
      { q: "Does it capture emails before checkout?", a: "No. Emails are captured only from a submitted checkout. The optional exit-intent popup captures with an explicit consent tick and a double opt-in, so an unconfirmed address is never mailed." },
      { q: "Will the emails send from my domain?", a: "Yes — through wp_mail, so your existing SMTP is used, with an honest From, your physical address, and one-click List-Unsubscribe built in." },
    ],
  },
  {
    label: "Consent & compliance",
    faqs: [
      { q: "Do you honor Global Privacy Control?", a: "Yes, at no cost, on both client and server. GPC honoring is legally required in California, Colorado, and Connecticut, and most competitors charge for it." },
      { q: "Will the banner break my forms or booking widget?", a: "No. Unrecognized scripts are allowed by default and flagged for review, rather than silently blocked, so your store keeps working." },
      { q: "Does installing it make me compliant?", a: "It gives you strong tools and safe defaults, but how you configure and use them — and whether your sends are lawful in your market — is between you and your counsel." },
    ],
  },
  {
    label: "Visitor resolution & billing",
    faqs: [
      { q: "What am I paying for with a plan?", a: "Visitor resolution — putting a name and email to anonymous abandoning shoppers, from your own consented traffic. It's the one thing with a real per-lookup cost." },
      { q: "How much is it?", a: "Monthly plans: 500 for $400, 1,000 for $700, or 2,500 for $1,500 — from $0.80 down to $0.60 per resolution. You're only billed for successful resolutions." },
      { q: "Is there a contract?", a: "No. Plans are month-to-month; cancel or change any time. The free plugin keeps working regardless." },
    ],
  },
  {
    label: "Technical",
    faqs: [
      { q: "What are the requirements?", a: "WordPress 6.4+, WooCommerce 8.0+, and PHP 8.1+. It's HPOS-compatible, supports the Cart/Checkout Blocks, and needs no build step." },
      { q: "Does it work with my caching plugin?", a: "Yes, automatically. The common caches (WP Rocket, LiteSpeed, W3TC, and others) are detected and excluded where needed." },
      { q: "Can developers extend it?", a: "Yes — standard WooCommerce hooks, shortcodes, and template-friendly emails. See the developer reference in the docs." },
    ],
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: groups.flatMap((g) =>
      g.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      }))
    ),
  },
];
---

<BaseLayout
  title="FAQ — CartConsent"
  description="Answers about CartConsent: what's free, how cart recovery and consent work, visitor-resolution pricing, and technical requirements."
  schema={schema}
>
  <section class="section-tight">
    <div class="container-content mx-auto max-w-3xl text-center">
      <span class="eyebrow justify-center">FAQ</span>
      <h1 class="mt-4 font-display text-[clamp(2.2rem,4.5vw,3.4rem)] font-extrabold leading-[1.05] tracking-tight text-[color:var(--color-ink)]">
        Questions, answered.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">
        Still stuck after this? <a href="/resources/support/" class="font-semibold text-[color:var(--color-brand)] hover:underline">Reach a human</a>.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container-content mx-auto max-w-3xl space-y-12">
      {groups.map((g) => (
        <div>
          <h2 class="font-display text-xl font-bold text-[color:var(--color-ink)]">{g.label}</h2>
          <div class="mt-5 space-y-3">
            {g.faqs.map((f) => (
              <details class="card group p-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-[color:var(--color-ink)]">
                  {f.q}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 transition-transform group-open:rotate-45"><path d="M12 5v14M5 12h14"/></svg>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section-dark section-tight">
    <div class="container-content text-center">
      <h2 class="mx-auto max-w-2xl display-2 text-[color:var(--color-on-inverse)]">Ready when you are.</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={SITE.github} class="btn-primary">Get the free plugin</a>
        <a href="/pricing/" class="btn-ghost border border-[color:var(--color-on-inverse-muted)]/30 text-[color:var(--color-on-inverse)]">See pricing</a>
      </div>
    </div>
  </section>
</BaseLayout>
