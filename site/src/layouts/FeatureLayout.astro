---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE } from "~/lib/site";

export interface FeatureData {
  slug: string;
  name: string;
  tagline: string;
  free: boolean;
  metaTitle: string;
  metaDescription: string;
  icon: string; // raw inner SVG paths
  intro: string;
  problem: { title: string; body: string };
  capabilities: { title: string; body: string }[];
  how: { title: string; body: string }[];
  highlight?: { title: string; body: string };
  faqs: { q: string; a: string }[];
  related: { name: string; href: string }[];
}

const { data } = Astro.props as { data: FeatureData };

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} schema={schema}>
  <!-- HERO -->
  <section class="section-tight">
    <div class="container-content grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-xl text-[color:var(--color-on-brand)]" style="background: var(--color-brand)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={data.icon} />
          </span>
          <span class={`rounded-full px-2.5 py-0.5 text-[11px] font-bold ${data.free ? "text-[color:var(--color-free)]" : "text-[color:var(--color-brand)]"}`} style={data.free ? "background:var(--color-free-soft)" : "background:var(--color-brand-soft)"}>
            {data.free ? "Free forever" : "Paid add-on"}
          </span>
        </div>
        <h1 class="mt-5 font-display text-[clamp(2.1rem,4.2vw,3.2rem)] font-extrabold leading-[1.06] tracking-tight text-[color:var(--color-ink)]">
          {data.name}
        </h1>
        <p class="mt-3 font-display text-xl font-bold text-[color:var(--color-brand)]">{data.tagline}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-[color:var(--color-ink-2)]">{data.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={data.free ? SITE.github : "/pricing/#resolution"} class="btn-primary">{data.free ? "Get the free plugin" : "See resolution plans"}</a>
          <a href="/demo/" class="btn-ghost border border-[color:var(--color-rule)]">See it in the demo →</a>
        </div>
      </div>
      <div class="card-elevated p-7">
        <div class="flex items-start gap-3 rounded-xl bg-[color:var(--color-danger-soft)] p-4">
          <svg class="mt-0.5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2.2" stroke-linecap="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
          <div>
            <div class="font-display text-sm font-bold text-[color:var(--color-ink)]">{data.problem.title}</div>
            <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{data.problem.body}</p>
          </div>
        </div>
        <div class="mt-4 space-y-2.5">
          {data.capabilities.slice(0, 4).map((c) => (
            <div class="flex items-start gap-2.5 text-sm text-[color:var(--color-ink-2)]">
              <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-free)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
              <span><strong class="text-[color:var(--color-ink)]">{c.title}.</strong> {c.body}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="section-tight bg-[color:var(--color-bg-alt)]">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">What you get</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">Everything the {data.name.toLowerCase()} does</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {data.capabilities.map((c) => (
          <div class="card p-6">
            <div class="grid size-9 place-items-center rounded-lg text-[color:var(--color-brand)]" style="background:var(--color-brand-soft)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h3 class="mt-4 font-display text-base font-bold text-[color:var(--color-ink)]">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <span class="eyebrow justify-center">How it works</span>
        <h2 class="mt-4 display-2 text-[color:var(--color-ink)]">Set up once, then it runs itself.</h2>
      </div>
      <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-3">
        {data.how.map((s, i) => (
          <div class="card p-7">
            <span class="step-badge">{i + 1}</span>
            <h3 class="mt-4 font-display text-lg font-bold text-[color:var(--color-ink)]">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {data.highlight && (
    <section class="section-dark section-tight">
      <div class="container-content mx-auto max-w-3xl text-center">
        <h2 class="display-2 text-[color:var(--color-on-inverse)]">{data.highlight.title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-[color:var(--color-on-inverse-muted)]">{data.highlight.body}</p>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section-tight bg-[color:var(--color-bg-alt)]">
    <div class="container-content mx-auto max-w-3xl">
      <h2 class="text-center display-2 text-[color:var(--color-ink)]">Questions</h2>
      <div class="mt-10 space-y-3">
        {data.faqs.map((f) => (
          <details class="card group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-[color:var(--color-ink)]">
              {f.q}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 transition-transform group-open:rotate-45"><path d="M12 5v14M5 12h14"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-ink-2)]">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED + CTA -->
  <section class="section-tight">
    <div class="container-content">
      <div class="flex flex-col items-start justify-between gap-6 rounded-2xl border border-[color:var(--color-rule)] bg-[color:var(--color-bg-alt)] p-8 md:flex-row md:items-center">
        <div>
          <h2 class="font-display text-xl font-bold text-[color:var(--color-ink)]">Keep exploring</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {data.related.map((r) => (
              <a href={r.href} class="rounded-full border border-[color:var(--color-rule)] px-3 py-1.5 text-sm font-medium text-[color:var(--color-ink-2)] transition-colors hover:border-[color:var(--color-brand)] hover:text-[color:var(--color-brand)]">{r.name} →</a>
            ))}
          </div>
        </div>
        <a href={data.free ? SITE.github : "/pricing/"} class="btn-primary shrink-0">{data.free ? "Get the free plugin" : "View pricing"}</a>
      </div>
    </div>
  </section>
</BaseLayout>
